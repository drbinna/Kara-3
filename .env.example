# Anam avatar platform key — https://anam.ai
ANAM_API_KEY=
# Anthropic API key — powers Kara's brain
ANTHROPIC_API_KEY=
# Optional: model for the fast brain (default claude-sonnet-4-6)
FAST_MODEL=
# Optional: set to 0 to enable the full brain (default 1 = demo mode, template serving only)
DEMO_MODE=
# Clerk auth (work-trial gating). Verification uses the instance's public JWKS —
# no secret key needed. Default issuer is the same instance as usegoblin.xyz.
CLERK_ISSUER=
# Set to 0 to disable the sign-in requirement (local dev / curl tests)
REQUIRE_AUTH=
# Clerk Backend API key (sk_...) — resolves signed-in users to emails for the
# work-trial allowlist. Unset = allowlist disabled, everyone gets the demo brain.
CLERK_SECRET_KEY=
# Path to the applicant email allowlist, one email per line (# = comment).
# On Fly this is /data/applicants.txt (set in fly.toml). Default: ./applicants.txt
APPLICANTS_FILE=
